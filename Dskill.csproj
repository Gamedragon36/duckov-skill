<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Dskill</AssemblyName>
    <RootNamespace>Dskill</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Duckov Skill</Product>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0169;CS0649</NoWarn>

    <!-- 정적 분석(코드 전수조사용): 권장 규칙으로 경고를 확인한다 -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Escape From Duckov 설치 경로 (Duckov.exe 가 있는 폴더) -->
    <DuckovPath>D:\Steam\steamapps\common\Escape from Duckov</DuckovPath>
    <DuckovManaged>$(DuckovPath)\Duckov_Data\Managed</DuckovManaged>
    <!-- 게임이 스캔하는 모드 폴더 -->
    <ModFolder>$(DuckovPath)\Duckov_Data\Mods\Dskill</ModFolder>
  </PropertyGroup>

  <!-- 게임 본체 + Unity 어셈블리 참조 (게임 폴더의 dll 을 그대로 사용, 복사하지 않음) -->
  <ItemGroup>
    <Reference Include="$(DuckovManaged)\TeamSoda.*">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(DuckovManaged)\ItemStatsSystem.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(DuckovManaged)\Unity*">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(DuckovManaged)\Unity.InputSystem.dll">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- 빌드 후 자동으로 게임 모드 폴더에 배포 -->
  <Target Name="DeployMod" AfterTargets="Build">
    <MakeDir Directories="$(ModFolder)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModFolder)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\info.ini" DestinationFolder="$(ModFolder)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\preview.png" DestinationFolder="$(ModFolder)" Condition="Exists('$(MSBuildProjectDirectory)\preview.png')" />
    <Message Importance="high" Text="[Dskill] 모드 배포 완료: $(ModFolder)" />
  </Target>

</Project>
